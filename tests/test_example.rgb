# Simple RGLite test example
def hello_world():
    print("Hello, World!")

# Variable assignment
x = 10
y = 20

# Arithmetic operations
result = x + y * 2

# Conditional statement
if result > 30:
    print("Result is greater than 30")
else:
    print("Result is 30 or less")

# While loop
counter = 0
while counter < 5:
    print("Counter:", counter)
    counter = counter + 1

# Function call
hello_world()