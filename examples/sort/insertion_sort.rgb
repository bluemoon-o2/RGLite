def insert_sorted(lst, x):
    result = []
    inserted = false
    i = 0
    n = len(lst)
    while i < n:
        if (not inserted) and x <= lst[i]:
            result.append(x)
            inserted = true
        result.append(lst[i])
        i = i + 1
    if not inserted:
        result.append(x)
    return result

def insertion_sort(arr):
    result = []
    i = 0
    n = len(arr)
    while i < n:
        result = insert_sorted(result, arr[i])
        i = i + 1
    return result

data = [5, 2, 8, 1, 3, 7, 4, 6]
sorted_data = insertion_sort(data)
print(sorted_data)
