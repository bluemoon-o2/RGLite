def merge(a, b):
    result = []
    i = 0
    j = 0
    while i < len(a) and j < len(b):
        if a[i] <= b[j]:
            result.append(a[i])
            i = i + 1
        else:
            result.append(b[j])
            j = j + 1
    while i < len(a):
        result.append(a[i])
        i = i + 1
    while j < len(b):
        result.append(b[j])
        j = j + 1
    return result

def merge_sort(arr):
    n = len(arr)
    if n <= 1:
        return arr
    mid = int(n / 2)
    left = []
    right = []
    i = 0
    while i < mid:
        left.append(arr[i])
        i = i + 1
    j = mid
    while j < n:
        right.append(arr[j])
        j = j + 1
    sorted_left = merge_sort(left)
    sorted_right = merge_sort(right)
    return merge(sorted_left, sorted_right)

data = [5, 2, 8, 1, 3, 7, 4, 6]
sorted_data = merge_sort(data)
print(sorted_data)
